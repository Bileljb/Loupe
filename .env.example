# Copy to .env.local and fill in. Never commit .env.local.

# Google PageSpeed Insights API key (restricted to the PSI API)
PSI_API_KEY=

# Upstash Redis (report storage, cache, rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for metadataBase, canonicals and the sitemap (e.g. https://example.com)
NEXT_PUBLIC_SITE_URL=

# Days before a shared report expires (default 30)
REPORT_TTL_DAYS=

# Rate limits: audits per IP per hour (default 5) and global daily PSI calls (default 1000)
AUDITS_PER_HOUR=
PSI_DAILY_CAP=
